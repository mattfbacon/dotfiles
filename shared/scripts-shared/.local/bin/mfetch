#!/bin/sh
printf "\033[1m$(whoami)@$(hostname)\033[0m"

BATTERY='/sys/class/power_supply/BAT1/capacity'
if test -f "$BATTERY"; then
	printf " with %s%%" "$(cat "$BATTERY")"
fi
printf '\n'

