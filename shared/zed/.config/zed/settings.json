{
	"vim_mode": true,
	"telemetry": {
		"diagnostics": false,
		"metrics": false,
	},
	"lsp": {
		"rust-analyzer": {
			"initialization_options": {
				"checkOnSave": {
					"command": "clippy",
					"allTargets": true,
				},
				"cargo": {
					"features": "all",
				},
				"rustfmt": {
					"extraArgs": [
						"+nightly",
					],
				},
			},
		},
	},
	"features": {
		"inline_completion_provider": null,
	},
	"buffer_font_family": "JuliaMono Nerd Font Mono",
	"buffer_line_height": {
		"custom": 1.37,
	},
	"buffer_font_size": 9,
	"ui_font_family": "JuliaMono Nerd Font Mono",
	"ui_font_size": 9,
	"show_copilot_suggestions": false,
	"show_whitespaces": "all",
	"relative_line_numbers": true,
	"inlay_hints": {
		"enabled": true,
	},
	"assistant": {
		"enabled": false,
	},
	"format": "auto",
	"hard_tabs": true,
	"tab_size": 2,
	"auto_update": false,
	"theme": {
		"mode": "system",
		"light": "Two Light",
		"dark": "Two Dark",
	},
	"project_panel": {
		"indent_size": 10,
		"default_width": 250,
	},
	"outline_panel": {
		"indent_size": 10,
	},
	"terminal": {
		"shell": {
			"program": "fish",
		},
		"default_height": 250,
	},
	"soft_wrap": "editor_width",
	"prettier": {
		"tabWidth": 2,
		"useTabs": true,
		"endOfLine": "lf",
		"embeddedLanguageFormatting": "auto",
		"printWidth": 100000,
		"trailingComma": "always",
	},
	"autosave": "on_focus_change",
	"show_wrap_guides": true,
	"wrap_guides": [
		80
	],
}
